<Window x:Class="WallpaperManager.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Visualizar papel de parede"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#FF0B0B0B">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Botões redondos translúcidos sobre a imagem (fechar e navegar) -->
        <Style x:Key="OverlayButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
                                CornerRadius="24" Background="#66000000" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#AA000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#DD000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Miniatura (aparece na hora) e, por cima, a imagem original quando terminar de carregar -->
        <Image x:Name="PlaceholderImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
        <Image x:Name="FullImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />

        <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ui:ProgressRing IsIndeterminate="True" />
            <TextBlock x:Name="LoadingText" Margin="0,12,0,0" HorizontalAlignment="Center" Foreground="White"
                       Text="Carregando a imagem original…" />
        </StackPanel>

        <!-- Topo: informações e fechar -->
        <Grid VerticalAlignment="Top" Height="96">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#B0000000" />
                    <GradientStop Offset="1" Color="#00000000" />
                </LinearGradientBrush>
            </Grid.Background>
            <StackPanel Margin="28,20,0,0" VerticalAlignment="Top">
                <TextBlock Foreground="White" FontSize="20" FontWeight="SemiBold">
                    <Run Text="{Binding SelectedTile.Item.Id, Mode=OneWay}" />
                    <Run Text="·" Foreground="#99FFFFFF" />
                    <Run Text="{Binding SelectedTile.Item.ResolutionText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Margin="0,2,0,0" Foreground="#CCFFFFFF" FontSize="13">
                    <Run Text="{Binding SelectedTile.Item.FileSizeText, Mode=OneWay}" />
                    <Run Text="·" />
                    <Run Text="{Binding PositionText, Mode=OneWay}" />
                    <Run Text="· use ← → para navegar, Esc para fechar" />
                </TextBlock>
            </StackPanel>
            <Button Width="44" Height="44" Margin="0,18,24,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Style="{StaticResource OverlayButtonStyle}" ToolTip="Fechar (Esc)" Click="Close_Click">
                <ui:SymbolIcon Symbol="Dismiss24" FontSize="20" Foreground="White" />
            </Button>
        </Grid>

        <!-- Navegação entre os papéis da página -->
        <Button Width="52" Height="52" Margin="24,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                Style="{StaticResource OverlayButtonStyle}" ToolTip="Anterior (←)" Click="Previous_Click">
            <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="24" Foreground="White" />
        </Button>
        <Button Width="52" Height="52" Margin="0,0,24,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                Style="{StaticResource OverlayButtonStyle}" ToolTip="Próximo (→)" Click="Next_Click">
            <ui:SymbolIcon Symbol="ChevronRight24" FontSize="24" Foreground="White" />
        </Button>

        <!-- Barra de ações flutuante -->
        <Border Margin="0,0,0,32" Padding="16,12" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                MaxWidth="1100" CornerRadius="12" BorderThickness="1"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" />
            </Border.Effect>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Margin="0,0,12,0" Padding="10,4" VerticalAlignment="Center" CornerRadius="6" Background="#FF107C10"
                            Visibility="{Binding SelectedTile.IsDownloaded, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock FontSize="12" Foreground="White" Text="✓ Já baixado" />
                    </Border>
                    <ui:TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Text="Monitor:" />
                    <ComboBox MinWidth="210" VerticalAlignment="Center"
                              ItemsSource="{Binding ApplyTargets}" SelectedItem="{Binding SelectedTarget}" />
                    <ui:Button Margin="12,0,0,0" Content="Baixar" Icon="{ui:SymbolIcon ArrowDownload24}"
                               ToolTip="Salva na pasta de downloads sem aplicar"
                               Command="{Binding DownloadOnlyCommand}" />
                    <ui:Button Margin="8,0,0,0" Appearance="Primary" Content="Baixar e aplicar"
                               Icon="{ui:SymbolIcon Checkmark24}"
                               Command="{Binding ApplyCommand}" />
                    <ui:Button Margin="8,0,0,0" Content="Cancelar" Icon="{ui:SymbolIcon Dismiss24}"
                               Command="{Binding CancelApplyCommand}"
                               Visibility="{Binding IsApplying, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <ProgressBar Margin="0,10,0,0" Maximum="100" Value="{Binding DownloadProgress, Mode=OneWay}"
                             Visibility="{Binding IsApplying, Converter={StaticResource BoolToVisibility}}" />
                <ui:TextBlock Margin="0,8,0,0" MaxWidth="760" HorizontalAlignment="Left" TextWrapping="Wrap" FontSize="12"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="{Binding ApplyMessage}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
